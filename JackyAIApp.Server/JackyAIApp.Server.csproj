<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SpaRoot>..\jackyaiapp.client</SpaRoot>
    <SpaProxyLaunchCommand>npm run dev</SpaProxyLaunchCommand>
    <SpaProxyServerUrl>https://localhost:5173</SpaProxyServerUrl>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <!-- Doc comments say what the code does not: a member or a parameter gets one only when it needs
         it, so none missing (CS1591), or only some of a method's parameters documented (CS1573), is
         a warning. A malformed comment (CS1570, CS1734) still is. -->
    <NoWarn>CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="JackyAIApp.Server.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="12.60.0" />
    <PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.5.2" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.6.0" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" Version="4.11.2" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.30.1" />
    <PackageReference Include="Betalgo.Ranul.OpenAI" Version="9.2.6" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="DataAnalysisLibrary.Core" Version="1.2.1" />
    <PackageReference Include="DataAnalysisLibrary.Connectors.MsSql" Version="1.2.1" />
    <PackageReference Include="DataAnalysisLibrary.Connectors.Adx" Version="1.2.1" />
    <PackageReference Include="DataAnalysisLibrary.Connectors.PostgreSql" Version="1.2.1" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="DotnetSdkUtilities" Version="1.0.6" />
    <PackageReference Include="HtmlAgilityPack" Version="1.13.1" />
    <PackageReference Include="itext" Version="9.8.0" />
    <PackageReference Include="itext.bouncy-castle-adapter" Version="9.8.0" />
    <PackageReference Include="MailKit" Version="4.18.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.SpaProxy" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageReference Include="NLog" Version="6.2.2" />
    <PackageReference Include="NLog.Extensions.Logging" Version="6.2.2" />
    <PackageReference Include="NLog.MailKit" Version="6.1.6" />
    <PackageReference Include="NLog.Web.AspNetCore" Version="6.2.2" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
    <!-- Images: the listening-question resize (ListeningImageProcessor: OpenAI-generated images and
         the author's own imports) and the AI assistant's chat attachments (AttachmentFileProcessor),
         which are user uploads. Held at 3.x: 4.x refuses to build without a Six Labors license key.
         3.1.12 carries five advisories fixed only in 4.1.2. Three are in code never run here:
         HistogramEqualization (GHSA-j3p4-wp97-rph4) and the TIFF CCITT T4/T6 encoders
         (GHSA-j9gm-c75j-xc9q, GHSA-jjfr-hcj7-qf5w). BigTIFF decoding (GHSA-wmxv-xphr-5c9g) is shut
         off for attachments, which are only decoded as PNG/JPEG/GIF/WebP. ICC profile parsing
         (GHSA-gwg2-r3hj-4w44, moderate) is still reachable through an uploaded PNG, JPEG or WebP
         carrying a crafted profile; 4.1.2+ closes it. Free under the Six Labors Split License for
         an individual with under 1M USD annual revenue. -->
    <PackageReference Include="TWStockLib" Version="3.0.0" />
    <PackageReference Include="WeCantSpell.Hunspell" Version="7.0.1" />
  </ItemGroup>

  <!-- Transitive packages pinned past a security advisory, until what brings them in moves on.
       Drop a pin once its parent depends on a fixed version itself. -->
  <ItemGroup>
    <!-- Via Microsoft.Data.SqlClient 6.1.1 (DataAnalysisLibrary.Connectors.MsSql, EF Core SqlServer):
         10.0.0-10.0.12 carry two .NET denial-of-service advisories, GHSA-846f-f764-76mx (High) and
         GHSA-2fmv-rv2c-59x7, fixed in 10.0.13. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\jackyaiapp.client\jackyaiapp.client.esproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <None Update="Dictionary\en_US.aff">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Dictionary\en_US.dic">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Prompt files as embedded resources -->
  <ItemGroup>
    <EmbeddedResource Include="Prompt\**\*.txt" />
  </ItemGroup>

</Project>
